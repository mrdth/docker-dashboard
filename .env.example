# Docker Dashboard Environment Configuration
# Copy this file to .env and update values for your deployment

# Backend configuration
BACKEND_PORT=3033
NODE_ENV=development
LOG_LEVEL=debug
FRONTEND_URL=http://localhost:8173

# Frontend configuration
FRONTEND_PORT=8173
VITE_API_URL=http://localhost:3033
VITE_WS_URL=ws://localhost:3033

# For deployment on your network, use your server IP:
# VITE_API_URL=http://192.168.1.86:3033
# VITE_WS_URL=ws://192.168.1.86:3033
# FRONTEND_URL=http://192.168.1.86:8173
